{
  "name": "office-content-search",
  "displayName": "Office Content Search",
  "description": "%description%",
  "version": "0.2.0",
  "icon": "media/icon.png",
  "publisher": "yoshihicode",
  "categories": [
    "Other"
  ],
  "keywords": [
    "office",
    "excel",
    "word",
    "powerpoint",
    "search",
    "xlsx",
    "docx",
    "pptx",
    "xls"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yoshihicode/office-content-search.git"
  },
  "bugs": {
    "url": "https://github.com/yoshihicode/office-content-search/issues"
  },
  "homepage": "https://github.com/yoshihicode/office-content-search",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "keybindings": [
      {
        "command": "officeSearch.copyFileName",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == officeSearch.results"
      },
      {
        "command": "officeSearch.copyPath",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "focusedView == officeSearch.results"
      }
    ],
    "commands": [
      {
        "command": "officeSearch.searchInFolder",
        "title": "%command.searchInFolder%",
        "category": "Office Search"
      },
      {
        "command": "officeSearch.openFile",
        "title": "%command.openFile%",
        "category": "Office Search"
      },
      {
        "command": "officeSearch.clearResults",
        "title": "%command.clearResults%",
        "category": "Office Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "officeSearch.copyFileName",
        "title": "%command.copyFileName%",
        "category": "Office Search",
        "icon": "$(copy)"
      },
      {
        "command": "officeSearch.copyPath",
        "title": "%command.copyPath%",
        "category": "Office Search"
      },
      {
        "command": "officeSearch.openAsText",
        "title": "%command.openAsText%",
        "category": "Office Search",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "officeSearch",
          "title": "%view.container%",
          "icon": "media/search.svg"
        }
      ]
    },
    "views": {
      "officeSearch": [
        {
          "type": "webview",
          "id": "officeSearch.form",
          "name": "%view.form%"
        },
        {
          "id": "officeSearch.results",
          "name": "%view.results%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "officeSearch.results",
        "contents": "%view.results.welcome%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "officeSearch.openAsText",
          "when": "view == officeSearch.results",
          "group": "navigation@1"
        },
        {
          "command": "officeSearch.clearResults",
          "when": "view == officeSearch.results",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "officeSearch.searchInFolder",
          "when": "explorerResourceIsFolder",
          "group": "4_search"
        }
      ],
      "commandPalette": [
        {
          "command": "officeSearch.openFile",
          "when": "false"
        },
        {
          "command": "officeSearch.searchInFolder",
          "when": "false"
        },
        {
          "command": "officeSearch.copyFileName",
          "when": "false"
        },
        {
          "command": "officeSearch.copyPath",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "officeSearch.copyFileName",
          "when": "view == officeSearch.results && viewItem == officeSearch.file",
          "group": "inline"
        },
        {
          "command": "officeSearch.copyFileName",
          "when": "view == officeSearch.results && viewItem =~ /^officeSearch\\.(file|hit|skip)$/",
          "group": "1_copy@1"
        },
        {
          "command": "officeSearch.copyPath",
          "when": "view == officeSearch.results && viewItem =~ /^officeSearch\\.(file|hit|skip)$/",
          "group": "1_copy@2"
        }
      ]
    },
    "configuration": {
      "title": "Office Content Search",
      "properties": {
        "officeSearch.includeSubfolders": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeSubfolders%"
        },
        "officeSearch.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "node_modules"
          ],
          "description": "%config.excludeFolders%"
        },
        "officeSearch.maxFileSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "%config.maxFileSizeMB%"
        },
        "officeSearch.maxHitsPerFile": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "%config.maxHitsPerFile%"
        },
        "officeSearch.excelShortDateFormat": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.excelShortDateFormat%",
          "examples": [
            "yyyy/m/d",
            "m/d/yyyy",
            "d/m/yyyy"
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "build": "npm run compile && npm run bundle",
    "watch": "npm run bundle -- --watch",
    "test": "npm run compile && node --test test/*.test.js",
    "l10n": "vscode-l10n-dev export --outDir ./l10n ./src",
    "check-l10n": "npm run l10n && node scripts/check-l10n.js",
    "vscode:prepublish": "npm run compile && npm run bundle -- --minify",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "saxes": "^6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}